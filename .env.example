# Copiar a .env y completar. Ver docs/architecture/system-design.md §1.

# Neon (branch de desarrollo). Debe empezar con postgres:// o postgresql://
DATABASE_URL=

# Clerk (instancia development). Google se activa en el dashboard de Clerk, no acá.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Email del super admin. Se promueve al sincronizar su usuario de Clerk (email verificado). Vacío = sin super admin.
SUPER_ADMIN_EMAIL=

# Vercel Blob (portadas de eventos, store con acceso público). Opcional: sin token solo falla subir portadas (503).
BLOB_READ_WRITE_TOKEN=

# Stripe (modo test). El webhook secret lo entrega `stripe listen`.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Job de vencimiento de ordenes (POST /api/internal/expire-orders). Opcional: sin ninguna, el endpoint responde 503.
# Local: Authorization: Bearer <INTERNAL_JOB_SECRET> (min 32 caracteres, p. ej. `openssl rand -hex 32`).
INTERNAL_JOB_SECRET=
# Produccion (Cloud Scheduler, token OIDC de Google): audiencia (URL) y cuenta de servicio (email) esperadas.
EXPIRE_ORDERS_AUDIENCE=
EXPIRE_ORDERS_SERVICE_ACCOUNT=
